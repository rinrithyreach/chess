{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomCode": {
        ".read": "auth != null",

        ".write": "auth != null && ($roomCode.matches(/^[A-HJ-NP-Z2-9]{6}$/)) && (!data.exists() || data.child('players/w/uid').val() === auth.uid || data.child('players/b/uid').val() === auth.uid || !data.child('players/w/uid').exists() || !data.child('players/b/uid').exists())",

        ".validate": "newData.hasChildren(['status', 'fen', 'turn', 'players'])",

        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },

        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
        },

        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(setup|playing|check|checkmate|draw|resigned|finished)$/)"
        },

        "fen": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "pgn": { ".validate": "newData.isString() && newData.val().length <= 20000" },
        "startFen": { ".validate": "newData.isString()" },

        "turn": { ".validate": "newData.isString() && newData.val().matches(/^(w|b)$/)" },

        "moves": {
          "$index": { ".validate": "newData.isString() && newData.val().length <= 10" }
        },

        "lastMove": {
          ".validate": "newData.hasChildren(['from', 'to'])",
          "from": { ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/)" },
          "to": { ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/)" },
          "$other": { ".validate": false }
        },

        "result": {
          ".validate": "newData.hasChildren(['label'])",
          "winner": { ".validate": "newData.isString() && newData.val().matches(/^(w|b)$/)" },
          "reason": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "detail": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        },

        "drawOffer": {
          ".validate": "newData.hasChild('from')",
          "from": {
            ".validate": "newData.isString() && newData.val().matches(/^(w|b)$/) && root.child('rooms').child($roomCode).child('players').child(newData.val()).child('uid').val() === auth.uid"
          },
          "$other": { ".validate": false }
        },

        "rematch": {
          "w": { ".validate": "newData.isBoolean()" },
          "b": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "players": {
          ".validate": "newData.hasChildren()",
          "$color": {
            ".validate": "$color.matches(/^(w|b)$/) && newData.hasChildren(['uid', 'name'])",
            "uid": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.parent().parent().child('w').child('uid').val() || newData.val() === data.parent().parent().child('b').child('uid').val())"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 6144 && newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,/)"
            },
            "connected": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "chat": {
          "$messageId": {
            ".validate": "newData.hasChildren(['uid', 'color', 'kind', 'body', 'at'])",

            "uid": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
            },

            "color": { ".validate": "newData.isString() && newData.val().matches(/^(w|b)$/) && (newData.val() === data.val() || root.child('rooms').child($roomCode).child('players').child(newData.val()).child('uid').val() === auth.uid)" },

            "kind": { ".validate": "newData.isString() && newData.val().matches(/^(text|emote)$/)" },
            "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "handles": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null",
          ".write": "auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'code'])",

          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/) && root.child('handles').child(newData.val()).val() === auth.uid" },
          "avatar": { ".validate": "newData.isString() && newData.val().length <= 6144 && newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,/)" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "presence": {
          ".read": "auth != null",
          ".write": "auth.uid === $uid",
          ".validate": "newData.hasChildren(['state', 'at'])",

          "state": { ".validate": "newData.isString() && newData.val().matches(/^(online|playing|offline)$/)" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "friends": {
          ".read": "auth.uid === $uid",
          "$friendUid": {
            ".write": "auth.uid === $uid || (auth.uid === $friendUid && (!newData.exists() || root.child('users').child($friendUid).child('requests').child($uid).exists()))",
            ".validate": "newData.hasChild('at')",
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "requests": {
          ".read": "auth.uid === $uid",
          "$fromUid": {
            ".write": "auth.uid === $uid || (auth.uid === $fromUid && $fromUid !== $uid)",
            ".validate": "newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "sent": {
          ".read": "auth.uid === $uid",
          "$toUid": {
            ".write": "auth.uid === $uid || auth.uid === $toUid",
            ".validate": "newData.hasChild('at')",
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
